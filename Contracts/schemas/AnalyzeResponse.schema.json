{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "x_min": {
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "title": "Y Max",
          "type": "number"
        },
        "frame": {
          "$ref": "#/$defs/CoordinateFrame",
          "default": "pixel"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CoordinateFrame": {
      "enum": [
        "pixel",
        "normalized"
      ],
      "title": "CoordinateFrame",
      "type": "string"
    },
    "DamageClass": {
      "enum": [
        "scratch",
        "dent",
        "crack",
        "broken",
        "rust",
        "paint_damage",
        "glass_damage"
      ],
      "title": "DamageClass",
      "type": "string"
    },
    "DamagePartAssociation": {
      "properties": {
        "detection_id": {
          "title": "Detection Id",
          "type": "string"
        },
        "part_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Id"
        },
        "iou": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iou"
        },
        "strategy": {
          "default": "iou_max",
          "enum": [
            "iou_max",
            "none"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "detection_id"
      ],
      "title": "DamagePartAssociation",
      "type": "object"
    },
    "ImageResult": {
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "detections": {
          "items": {
            "$ref": "#/$defs/YoloDetection"
          },
          "title": "Detections",
          "type": "array"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/PartSegmentation"
          },
          "title": "Parts",
          "type": "array"
        },
        "associations": {
          "items": {
            "$ref": "#/$defs/DamagePartAssociation"
          },
          "title": "Associations",
          "type": "array"
        }
      },
      "required": [
        "image_id",
        "width",
        "height",
        "detections",
        "parts",
        "associations"
      ],
      "title": "ImageResult",
      "type": "object"
    },
    "OverlayAsset": {
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "kind": {
          "default": "fusion_overlay",
          "enum": [
            "segmentation_overlay",
            "detection_overlay",
            "fusion_overlay"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mime_type": {
          "const": "image/png",
          "default": "image/png",
          "enum": [
            "image/png"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "data_base64": {
          "title": "Data Base64",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "data_base64"
      ],
      "title": "OverlayAsset",
      "type": "object"
    },
    "PartSegmentation": {
      "properties": {
        "part_id": {
          "title": "Part Id",
          "type": "string"
        },
        "vehicle_part": {
          "$ref": "#/$defs/VehiclePart"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "mask": {
          "$ref": "#/$defs/SegmentationMask"
        }
      },
      "required": [
        "part_id",
        "vehicle_part",
        "mask"
      ],
      "title": "PartSegmentation",
      "type": "object"
    },
    "Point": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "properties": {
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "minItems": 3,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "RLEMask": {
      "properties": {
        "size": {
          "description": "[height, width]",
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Size",
          "type": "array"
        },
        "counts": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "title": "Counts"
        }
      },
      "required": [
        "size",
        "counts"
      ],
      "title": "RLEMask",
      "type": "object"
    },
    "SegmentationMask": {
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rle": {
          "anyOf": [
            {
              "$ref": "#/$defs/RLEMask"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SegmentationMask",
      "type": "object"
    },
    "VehiclePart": {
      "enum": [
        "front_bumper",
        "rear_bumper",
        "hood",
        "trunk",
        "front_left_door",
        "front_right_door",
        "rear_left_door",
        "rear_right_door",
        "left_fender",
        "right_fender",
        "left_mirror",
        "right_mirror",
        "windshield",
        "roof"
      ],
      "title": "VehiclePart",
      "type": "string"
    },
    "YoloDetection": {
      "properties": {
        "detection_id": {
          "title": "Detection Id",
          "type": "string"
        },
        "damage_class": {
          "$ref": "#/$defs/DamageClass"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/SegmentationMask"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "detection_id",
        "damage_class",
        "confidence",
        "bbox"
      ],
      "title": "YoloDetection",
      "type": "object"
    }
  },
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "status": {
      "const": "ok",
      "default": "ok",
      "enum": [
        "ok"
      ],
      "title": "Status",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ImageResult"
      },
      "title": "Results",
      "type": "array"
    },
    "overlays": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/OverlayAsset"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overlays"
    },
    "warnings": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warnings"
    }
  },
  "required": [
    "request_id",
    "analysis_id",
    "results"
  ],
  "title": "AnalyzeResponse",
  "type": "object"
}